# Neon Postgres connection string. Needed from step 5 (players and database).
DATABASE_URL=

# Seed for the daily puzzle, at least 32 characters. NEVER rotate it: a new
# value rewrites every past puzzle. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DAILY_SECRET=

# Signs the player id cookie, at least 32 characters. Same command as above.
COOKIE_SECRET=

# Date of puzzle #1, YYYY-MM-DD.
LAUNCH_DATE=
